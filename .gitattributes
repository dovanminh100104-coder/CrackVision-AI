# =========================================================================
# GitHub Linguist Language Configuration
# =========================================================================

# 1. Force GitHub Linguist to analyze demo/ folder (by default 'demo/' is ignored as documentation)
demo/** -linguist-documentation
demo/** -linguist-vendored
demo/** linguist-detectable

# 2. Explicitly enable core application programming languages
*.py linguist-detectable
*.js linguist-detectable
*.html linguist-detectable
*.css linguist-detectable

demo/backend/*.py linguist-detectable
demo/frontend/*.js linguist-detectable
demo/frontend/*.html linguist-detectable
demo/frontend/*.css linguist-detectable
tests/*.py linguist-detectable

# 3. Vendor and document heavy Jupyter Notebooks (44MB) so they do not overpower source code
*.ipynb linguist-documentation
*.ipynb linguist-vendored
notebook/** linguist-documentation
notebook/** linguist-vendored

# 4. Vendor model outputs and images
Model/** linguist-vendored
Model/** linguist-documentation
