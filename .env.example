# =========================================================================
# AI CRACKVISION PRO - ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# -------------------------------------------------------------------------
# Cổng mạng chính của máy chủ FastAPI (Bắt buộc, mặc định: 8000)
SERVER_PORT=8000

# Cổng phụ cho tên miền nội bộ crackvision.ai (Tùy chọn: 80, cần quyền Administrator)
HTTP_PORT=80

# Địa chỉ lắng nghe của máy chủ (0.0.0.0 cho phép truy cập qua LAN, 127.0.0.1 chỉ nội bộ máy)
SERVER_HOST=0.0.0.0

# Chế độ vận hành (development / production)
ENVIRONMENT=production

# -------------------------------------------------------------------------
# 2. MICROSOFT SQL SERVER CONFIGURATION (PRIMARY ENGINE)
# -------------------------------------------------------------------------
# Tên instance SQL Server (. hoặc localhost cho MSSQLSERVER mặc định, .\SQLEXPRESS cho bản Express)
MSSQL_SERVER=.

# Tên cơ sở dữ liệu trên SQL Server (Tự động khởi tạo nếu chưa có)
MSSQL_DATABASE=CrackVisionDB

# Tên Driver ODBC đã cài trên máy Windows (ODBC Driver 17 for SQL Server hoặc 18)
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Xác thực kết nối Windows (yes: Windows Authentication / no: SQL Authentication với sa/password)
MSSQL_TRUSTED_CONNECTION=yes

# Bỏ qua xác thực chứng chỉ SSL máy chủ nội bộ
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# -------------------------------------------------------------------------
# 3. SQLITE DATABASE CONFIGURATION (FALLBACK & LOCAL REPLICA)
# -------------------------------------------------------------------------
# Đường dẫn tệp SQLite lưu trữ cơ sở dữ liệu cục bộ ngoại tuyến
SQLITE_DB_PATH=demo/backend/crackvision.db

# Chế độ ghi nhật ký SQLite tối ưu hóa đa luồng (WAL = Write-Ahead Logging)
SQLITE_JOURNAL_MODE=WAL

# -------------------------------------------------------------------------
# 4. DEEP LEARNING & AI INFERENCE ENGINE
# -------------------------------------------------------------------------
# Thiết bị suy luận AI (cpu / cuda / auto)
AI_DEVICE=cpu

# Số luồng CPU sử dụng để tính toán đa nhân (Mặc định: tự động lấy số luồng CPU của máy)
TORCH_NUM_THREADS=8

# Mô hình AI mặc định khi mở ứng dụng (compact_unet / unet_resnet34_512 / deeplabv3_finetuned)
DEFAULT_MODEL=compact_unet

# Ngưỡng nhị phân mặc định để phân tách điểm ảnh nứt (0.0 đến 1.0, khuyến nghị: 0.50)
DEFAULT_THRESHOLD=0.50

# Độ phân giải ảnh đầu vào mô hình (256 hoặc 512)
DEFAULT_IMG_SIZE=512

# -------------------------------------------------------------------------
# 5. GIAO DIỆN & TÊN MIỀN NỘI BỘ
# -------------------------------------------------------------------------
# Tên miền ảo nội bộ chính thức
APP_DOMAIN=crackvision.ai

# Tự động mở trình duyệt Chrome khi khởi động máy chủ (true / false)
AUTO_OPEN_BROWSER=true

